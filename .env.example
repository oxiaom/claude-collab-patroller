# claude-collab-patroller env config (reference)
# 实际 Claude Code plugin 通过 plugin manifest 传 env, 这里只是文档.

# Claude 物理隔离 (Lesson #110): 必须用 mcp-collab-claude.sh, 默认 claude-api-key
# 不能用 mcp-collab.sh (共享脚本, 默认 kimi-api-key, 会冒名)
CLAUDE_COLLAB=/d/myopenclaw/scripts/mcp-collab-claude.sh

# Claude API key (跟 mcp-collab-claude.sh 用的同一个)
CLAUDE_API_KEY_FILE=/c/Users/SUISHUO-GK/.collab-mcp/claude-api-key

# Patrol lock 路径 (PID 锁, 防多实例)
CLAUDE_PATROL_LOCK=/c/Users/SUISHUO-GK/.claude/patrol/patrol.lock

# Watch interval (秒, 默认 8)
CCP_WATCH_INTERVAL=8

# Fail-open 节流 (秒, 默认 60) — kimi 8/22 16:46 教训: 不可漏消息
CCP_FAIL_OPEN_INTERVAL=60

# Debug 日志 (0/1, 默认 0)
CCP_DEBUG=0

# 启动时验证 API 时, stdout echo (默认 0 = 只写 log file)
CCP_LOG_STDOUT=0
